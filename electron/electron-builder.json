{
  "appId": "com.vertech-innovations.happypix",
  "productName": "HappyPix Booth",
  "publish": {
    "provider": "github",
    "owner": "Krishna-Vineet",
    "repo": "happypix-releases"
  },
  "files": ["dist-electron", "dist-react"],
  "extraResources": [
    "dist-electron/preload.cjs",
    {
      "from": "resources",
      "to": "resources"
    }
  ],
  "icon": "./icon.ico",
  "asar": true,
  "directories": {
    "output": "release"
  },
  "mac": {
    "target": "dmg",
    "category": "public.app-category.photography",
    "extendInfo": {
      "NSCameraUsageDescription": "HappyPix Booth uses the connected camera to create guest photo sessions.",
      "NSMicrophoneUsageDescription": "HappyPix Booth does not record audio."
    }
  },
  "linux": {
    "target": "AppImage",
    "category": "Photography"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "HappyPix Booth",
    "runAfterFinish": true
  }
}
