# ─── Server Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# ─── App ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────
# From: https://cloud.mongodb.com → your cluster → Connect
# Atlas Network Access must allow 0.0.0.0/0 on Vercel (no fixed egress IPs).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/happypix

# ─── JWT Authentication ───────────────────────────────────────────
# Min 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_key_minimum_32_characters

# ─── Cloudinary (File & Photo Storage) ──────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Razorpay (Payments) ──────────────────────────────────────────
# rzp_test_... for testing, rzp_live_... for production.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Email (SendGrid) ─────────────────────────────────────────────
# Without SENDGRID_API_KEY, OTP mail (password reset, email change) and
# guest photo links are SKIPPED SILENTLY — no error, no email.
SENDGRID_API_KEY=
# Must be a verified sender / authenticated domain in SendGrid, or every
# send is rejected with 403.
EMAIL_FROM_ADDRESS=noreply@happypix.com.au

# ─── App URLs ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
# Public display site. Booth sessions create a 24-hour guest download
# link at <WEBSITE_URL>/download/<id>; its QR goes on the success screen.
WEBSITE_URL=https://happypix.app

# ─── CORS ─────────────────────────────────────────────────────────
# The ONLY source of origins — nothing is hardcoded in server.js. Vercel
# deployment aliases (*.vercel.app) are matched by pattern, so this list
# is for real domains. Comma separated, no spaces, no trailing slash.
#
# Local dev origins are added automatically when NODE_ENV !== production.
#
# Production:
# ALLOWED_ORIGINS=https://happypix.app,https://www.happypix.app,https://crm.happypix.app,https://webapi.happypix.app,https://demo.happypix.app,https://docs.happypix.app
ALLOWED_ORIGINS=

# ─── Cron ─────────────────────────────────────────────────────────
# The account-deletion sweep runs from the Vercel cron. That endpoint
# FAILS CLOSED: no secret means 401 and no deletion ever happens.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
