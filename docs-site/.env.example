# ─────────────────────────────────────────────────────────────────
#  HappyPix field guide — environment
#
#  Copy to `.env` for local work, and set the same keys in Vercel →
#  Project → Settings → Environment Variables for each environment.
#
#  These are inlined into the bundle at BUILD time, so changing one
#  always means a redeploy — editing it on the server after the fact
#  changes nothing.
#
#  Every value is safe to expose: they are URLs, not secrets. Nothing
#  here should ever hold an API key, a database URI or a password.
# ─────────────────────────────────────────────────────────────────

# ── Where the field guide itself lives ─────────────────────────────
# Used in exported Markdown headers and copy-link. Leave blank and it
# falls back to the browser's own origin, which is right for previews.
# Live example: https://docs.happypix.in
VITE_DOCS_URL=

# ── The main website ───────────────────────────────────────────────
# Marketing site. The three below default to paths on this host, so you
# normally only need to set this one.
VITE_WEBSITE_URL=https://happypix.vercel.app

# Optional overrides. Commented out = derive from VITE_WEBSITE_URL.
# VITE_PRICING_URL=https://happypix.in/pricing#checkout
# VITE_CONTACT_URL=https://happypix.in/contact
# VITE_SOFTWARE_URL=https://happypix.in/software

# ── The CRM workspace ──────────────────────────────────────────────
# Currently on Vercel; swap in the real domain when it exists.
VITE_CRM_URL=https://happypixcrm.vercel.app

# ── Backends ───────────────────────────────────────────────────────
# Main API: authentication and the private member payload.
# Local dev can leave this blank — the Vite proxy forwards /api to
# DOCS_API_TARGET (default http://127.0.0.1:5000).
VITE_API_URL=https://happypix-v2-backend.vercel.app

# Website API: the public backend that receives contact-form leads.
# Leave blank in dev to use the /lead-api proxy.
VITE_LEADS_API_URL=https://happypixurl.vercel.app

# ── Booth app downloads ────────────────────────────────────────────
# Leave blank to render the download card as "coming soon" rather than
# linking to a store listing that does not exist yet.
# VITE_IOS_URL=https://apps.apple.com/app/…
# VITE_ANDROID_URL=https://play.google.com/store/apps/details?id=…
# VITE_WINDOWS_URL=https://happypix.in/downloads/happypix-booth.exe

# ── Dev-only: where the Vite proxy sends traffic ───────────────────
# Not VITE_ prefixed on purpose — these are read by vite.config.js at
# dev-server start, never shipped to the browser.
DOCS_API_TARGET=http://127.0.0.1:5000
DOCS_LEADS_API_TARGET=http://127.0.0.1:5001
