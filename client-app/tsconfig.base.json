{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "jsx": "react-native",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@happypix/*": ["./packages/*/src", "./packages/*"]
    }
  },
  "exclude": ["node_modules"]
}
